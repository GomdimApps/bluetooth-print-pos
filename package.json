{
  "name": "web-escpos-printer",
  "version": "1.1.0",
  "description": "Print to ESC/POS/StarPRNT thermal receipt printers straight from the browser, over Web Bluetooth or QZ Tray, with no Node at runtime. Builds receipts (text, images, barcodes, QR, PDF417) from a JSON object, with a built-in preview renderer to test without a physical printer.",
  "main": "build/web-escpos-printer.js",
  "module": "build/web-escpos-printer.esm.js",
  "types": "build/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GomdimApps/web-escpos-printer.git"
  },
  "homepage": "https://github.com/GomdimApps/web-escpos-printer#readme",
  "bugs": {
    "url": "https://github.com/GomdimApps/web-escpos-printer/issues"
  },
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "import": "./build/web-escpos-printer.esm.js",
      "browser": "./build/web-escpos-printer.js",
      "require": "./build/web-escpos-printer.js",
      "default": "./build/web-escpos-printer.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "webpack --mode production && npm run build:types",
    "build:standalone": "webpack --mode production --config-name umd",
    "build:types": "tsc -p tsconfig.build.json",
    "build:dev": "webpack --mode development --watch",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "escpos",
    "star-prnt",
    "receipt-printer",
    "thermal-printer",
    "bluetooth",
    "web-bluetooth",
    "qz-tray",
    "barcode",
    "qrcode",
    "pdf417",
    "browser",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bwip-js/browser": "^4.11.2",
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "canvas-dither": "^1.0.1",
    "qrcode-generator": "^2.0.4",
    "qz-tray": "^2.2.6"
  },
  "devDependencies": {
    "@types/qz-tray": "^2.2.2",
    "@types/web-bluetooth": "^0.0.21",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4"
  }
}
